[elastic]
# Elasticsearch en Kibana endpoints (bijv. via oc port-forward of Route)
elasticsearch_url = https://localhost:9200
kibana_url = https://localhost:5601

# Gebruiker met rechten om rollen/users te beheren en Fleet policies te verwijderen
username = elastic

# true | false | pad naar CA-bestand (bijv. /pad/naar/ca.crt)
verify_ssl = false

# ID van de te resetten agent policy (hoofdlettergevoelig)
policy_id = Kafka-consumer
